{
  "name": "base-11ty-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "eleventy --serve --incremental",
    "prepanel:serve": "npx @11ty/eleventy",
    "panel:serve": "node scripts/panel-php-serve.cjs",
    "start": "npm-run-all css:build --parallel css:watch serve panel:serve",
    "dev": "npm start",
    "build": "npm run css:build && eleventy",
    "panel:hash": "node ./scripts/panel-hash.cjs",
    "images:optimize": "python scripts/optimize-webp.py",
    "css:build": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/assets/css/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/assets/css/styles.css --watch"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  }
}
