---
layout: base.njk
title: Home
description: Welcome to the base Eleventy website.
---

<section
  id="hero-section"
  class="relative -mt-20 min-h-[100svh] w-full overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-[var(--color-brand-teal)] pt-20 sm:-mt-24 sm:pt-24"
>
  <video
    id="hero-video"
    class="absolute inset-0 z-0 min-h-[100%] min-w-full object-cover"
    src="{{ '/assets/videos/hero-video.mp4' | url }}"
    muted
    autoplay
    loop
    playsinline
    preload="auto"
    webkit-playsinline=""
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <script>
    (function () {
      var v = document.getElementById("hero-video");
      if (!v) return;

      function prepare() {
        v.muted = true;
        v.defaultMuted = true;
        v.setAttribute("muted", "");
        try {
          v.playsInline = true;
        } catch (_) {}
        v.setAttribute("playsinline", "");
        v.setAttribute("webkit-playsinline", "");
      }

      function tryPlay() {
        prepare();
        var p = v.play();
        if (p && typeof p.catch === "function") {
          p.catch(function () {});
        }
      }

      function onError() {
        try {
          v.removeAttribute("src");
        } catch (_) {}
        v.classList.add("hidden");
      }

      v.addEventListener("error", onError);

      function init() {
        prepare();
        tryPlay();
        v.addEventListener("loadedmetadata", tryPlay);
        v.addEventListener("canplay", tryPlay);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }

      document.addEventListener(
        "pointerdown",
        function () {
          tryPlay();
        },
        true,
      );

      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) tryPlay();
      });
    })();
  </script>

  <!-- Dark overlay -->
  <div class="absolute inset-0 z-[1] bg-black/75"></div>

  <div class="relative z-10 flex min-h-[100svh] items-center justify-center px-4">
    <div class="text-center max-w-3xl">
      <h1 class="text-white tracking-tight">
        <span class="block text-3xl sm:text-5xl font-light">Ритеил парк</span>
        <span class="block text-4xl sm:text-6xl font-extrabold mt-2">Раковски</span>
      </h1>

      <p class="mt-6 text-white/90 text-base sm:text-lg leading-relaxed">
        Всичко от което се нуждате е вече на едно място. Спестяваш време
      </p>

      <div class="mt-8 flex items-center justify-center">
        <a
          href="{{ '/services/' | url }}"
          class="inline-flex items-center justify-center rounded-2xl bg-brand-yellow px-7 py-3 text-white font-semibold shadow-lg shadow-black/20 hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-black/30"
        >
          Разгледай обектите
        </a>
      </div>
    </div>
  </div>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: За нас  (editorial, dark, split-screen with stat ribbon)
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-stretch">
      {# ── IMAGE CARD (floating) ── #}
      <div class="relative order-last lg:order-last lg:col-span-5 rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden ring-1 ring-white/40 shadow-2xl shadow-slate-900/15 min-h-[320px] sm:min-h-[420px] lg:min-h-[520px]">
        <img
          src="{{ home.about.image.src }}"
          alt="{{ home.about.image.alt }}"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-950/60 via-slate-950/25 to-brand-teal/20 mix-blend-multiply" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/10 to-transparent" aria-hidden="true"></div>

        <div class="absolute left-6 top-6 sm:left-8 sm:top-8 flex items-center gap-3">
          <span class="h-px w-8 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-white/85">{{ home.about.floatingBadge.eyebrow }}</span>
        </div>

        <div class="absolute left-6 bottom-6 sm:left-10 sm:bottom-10 max-w-[85%]">
          <div class="text-[10px] sm:text-xs font-medium tracking-[0.3em] uppercase text-white/70">{{ home.about.floatingBadge.line1 }}</div>
          <div class="mt-1 text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[0.95] uppercase">
            {{ home.about.floatingBadge.line2 }}
          </div>
        </div>
      </div>

      {# ── TEXT CARD (floating) ── #}
      <div class="relative order-first lg:order-first lg:col-span-7 rounded-[2rem] sm:rounded-[2.5rem] bg-white/92 backdrop-blur-sm flex flex-col lg:justify-center">
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">{{ home.about.badge }}</span>
        </div>

        <h2 class="mt-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
          {{ home.about.titlePrefix }}
          <span class="block italic font-light text-slate-900">
            <span class="underline decoration-brand-yellow decoration-[3px] underline-offset-[10px]">{{ home.about.titleHighlight }}</span>.
          </span>
        </h2>

        <div class="mt-8 space-y-4 text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl">
          {% for paragraph in home.about.paragraphs %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-5">
          {% for button in home.about.buttons %}
            {% if button.style == 'primary' %}
              <a
                href="{{ button.url | url }}"
                class="inline-flex items-center gap-2 rounded-full bg-brand-yellow px-6 py-3 text-sm font-semibold tracking-wide text-slate-950 shadow-lg shadow-black/20 transition hover:brightness-110"
              >
                {{ button.label }}
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
              </a>
            {% else %}
              <a
                href="{{ button.url | url }}"
                class="group inline-flex items-center gap-2 text-sm font-semibold tracking-wide text-slate-700 hover:text-slate-900"
              >
                {{ button.label }}
                <span class="h-px w-6 bg-slate-400 transition-all group-hover:w-10 group-hover:bg-brand-yellow"></span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {# ── SEPARATE COUNTER STRIP (floating) ── #}
    <div class="mt-8 sm:mt-10 rounded-[1.75rem] sm:rounded-[2.25rem] overflow-hidden bg-white shadow-xl shadow-slate-900/10">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-slate-200/80">
        {% for counter in home.about.counters %}
          {% set suffixIsUnit = counter.suffix and counter.suffix != '+' %}
          <div class="relative px-5 py-7 sm:px-7 sm:py-9 group">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 tabular-nums js-counter" data-counter-target="{{ counter.value }}">0</span>
              {% if counter.suffix == '+' %}
                <span class="text-2xl sm:text-3xl font-extrabold text-brand-yellow leading-none">+</span>
              {% elif suffixIsUnit %}
                <span class="text-base sm:text-lg font-medium text-slate-500 leading-none">{{ counter.suffix }}</span>
              {% endif %}
            </div>
            <div class="mt-3 text-[10px] sm:text-xs uppercase tracking-[0.25em] font-semibold text-slate-500">{{ counter.label }}</div>
            <span class="absolute left-5 sm:left-7 bottom-3 h-px w-0 bg-brand-yellow/80 transition-all duration-500 group-hover:w-12"></span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <script src="{{ '/assets/js/counters.js' | url }}" defer></script>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: Обекти  (editorial, floating cards — no wrapper container)
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">

    {# ── EDITORIAL HEADER ── #}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-8">
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">Обекти</span>
        </div>

        <h2 class="mt-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
          Търговски обекти
          <span class="block italic font-light text-slate-900">
            <span class="underline decoration-brand-yellow decoration-[3px] underline-offset-[10px]">и партньори</span>.
          </span>
        </h2>

        <p class="mt-8 text-base sm:text-lg text-slate-600 leading-relaxed max-w-4xl">
          Всичко от което се нуждаете на едно място — пазар, мода, услуги и хранене. Подбрани марки и удобства, събрани под един покрив.
        </p>
      </div>
    </div>

  </div>

  {# ── MOVING / DRAGGABLE PARTNER STRIP (full viewport width) ── #}
  <div class="partners-strip-wrapper mt-10 sm:mt-14 pb-4">
    <div class="pt-4 partners-strip" aria-label="Партньори">
      <div class="partners-strip-set">
        {% for shop in shops.items %}
          <article
            class=" group relative w-[250px] sm:w-[280px] flex-shrink-0 rounded-3xl bg-white ring-1 ring-slate-200/70 p-7 sm:p-8 hover:-translate-y-1 transition-all duration-300"
          >
            <span
              class="absolute left-8 top-0 h-px w-10 -translate-y-px bg-brand-yellow transition-all duration-300 group-hover:w-24"
              aria-hidden="true"
            ></span>

            <div
              class="h-16 w-16 sm:h-20 sm:w-20 rounded-full flex items-center justify-center text-white font-bold text-2xl sm:text-3xl"
              style="background-color: {{ shop.color | default('#006484') }}"
            >
              {{ shop.title | truncate(1, true, '') }}
            </div>

            <h3 class="mt-7 text-xl sm:text-2xl font-bold text-slate-900 leading-tight">{{ shop.title }}</h3>
            <p class="mt-2 text-[11px] sm:text-xs uppercase tracking-[0.2em] font-semibold text-slate-500">{{ shop.category }}</p>

            <a
              href="{{ shop.url | default('#') }}"
              class="absolute right-7 bottom-7 inline-flex h-10 w-10 items-center justify-center rounded-full ring-1 ring-slate-200 text-slate-400 group-hover:text-slate-900 group-hover:ring-slate-900 transition"
              aria-label="Виж повече за {{ shop.title }}"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            </a>
          </article>
        {% endfor %}
      </div>
      <div class="partners-strip-set" aria-hidden="true">
        {% for shop in shops.items %}
          <article
            class="group relative w-[250px] sm:w-[280px] flex-shrink-0 rounded-3xl bg-white ring-1 ring-slate-200/70 p-7 sm:p-8 hover:-translate-y-1 hover:ring-slate-900 transition-all duration-300"
          >
            <span
              class="absolute left-8 top-0 h-px w-10 -translate-y-px bg-brand-yellow transition-all duration-300 group-hover:w-24"
              aria-hidden="true"
            ></span>

            <div
              class="h-16 w-16 sm:h-20 sm:w-20 rounded-full flex items-center justify-center text-white font-bold text-2xl sm:text-3xl"
              style="background-color: {{ shop.color | default('#006484') }}"
            >
              {{ shop.title | truncate(1, true, '') }}
            </div>

            <h3 class="mt-7 text-xl sm:text-2xl font-bold text-slate-900 leading-tight">{{ shop.title }}</h3>
            <p class="mt-2 text-[11px] sm:text-xs uppercase tracking-[0.2em] font-semibold text-slate-500">{{ shop.category }}</p>

            <a
              href="{{ shop.url | default('#') }}"
              class="absolute right-7 bottom-7 inline-flex h-10 w-10 items-center justify-center rounded-full ring-1 ring-slate-200 text-slate-400 group-hover:text-slate-900 group-hover:ring-slate-900 transition"
              aria-label="Виж повече за {{ shop.title }}"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            </a>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
  <script src="{{ '/assets/js/partners-strip.js' | url }}" defer></script>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: Последни новини
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute top-1/2 -left-40 h-[420px] w-[420px] -translate-y-1/2 rounded-full bg-brand-teal/5 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-32 right-1/3 h-72 w-72 rounded-full bg-brand-yellow/5 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-12 sm:mb-14">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2.5 rounded-full bg-brand-yellow/15 px-4 py-1.5 ring-1 ring-brand-yellow/30">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
          <span class="text-[11px] sm:text-xs font-semibold tracking-[0.25em] text-brand-yellow uppercase">Новини</span>
        </span>
        <h2 class="mt-5 text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
          Последни новини
        </h2>
        <div class="mt-5 flex items-center gap-2">
          <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
          <span class="h-1 w-12 rounded-full bg-brand-yellow"></span>
          <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
        </div>
      </div>
      <a
        href="#"
        class="self-start sm:self-auto inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 ring-1 ring-slate-200 hover:ring-brand-yellow hover:text-brand-teal transition"
      >
        Всички новини
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {% for post in news.items %}
        <article class="group rounded-3xl bg-white overflow-hidden ring-1 ring-slate-200/70 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src="{{ post.image }}"
              alt="{{ post.title }}"
              class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-white/95 backdrop-blur px-3 py-1 text-xs font-semibold text-slate-900 shadow">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
              {{ post.date }}
            </div>
          </div>
          <div class="p-6 sm:p-7">
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-brand-teal transition-colors">
              {{ post.title }}
            </h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed line-clamp-3">
              {{ post.excerpt }}
            </p>
            <a
              href="{{ post.url | default('#') }}"
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-teal"
            >
              Прочети повече
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

