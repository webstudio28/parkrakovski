---
layout: base.njk
title: Home
description: Welcome to the base Eleventy website.
---

<section
  id="hero-section"
  class="relative isolate h-[100svh] w-full overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-[var(--color-brand-teal)]"
>
  <video
    id="hero-video"
    class="pointer-events-none absolute inset-0 z-0 min-h-full min-w-full origin-center scale-[1.02] border-0 object-cover outline-none ring-0"
    src="{{ '/assets/videos/hero-video.mp4' | url }}"
    muted
    autoplay
    loop
    playsinline
    preload="auto"
    webkit-playsinline=""
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <script>
    (function () {
      var v = document.getElementById("hero-video");
      if (!v) return;

      function prepare() {
        v.muted = true;
        v.defaultMuted = true;
        v.setAttribute("muted", "");
        try {
          v.playsInline = true;
        } catch (_) {}
        v.setAttribute("playsinline", "");
        v.setAttribute("webkit-playsinline", "");
      }

      function tryPlay() {
        prepare();
        var p = v.play();
        if (p && typeof p.catch === "function") {
          p.catch(function () {});
        }
      }

      function onError() {
        try {
          v.removeAttribute("src");
        } catch (_) {}
        v.classList.add("hidden");
      }

      v.addEventListener("error", onError);

      function init() {
        prepare();
        tryPlay();
        v.addEventListener("loadedmetadata", tryPlay);
        v.addEventListener("canplay", tryPlay);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }

      document.addEventListener(
        "pointerdown",
        function () {
          tryPlay();
        },
        true,
      );

      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) tryPlay();
      });
    })();
  </script>

  <!-- Dark overlay -->
  <div class="absolute inset-0 z-[1] bg-black/60"></div>

  <!-- Left vertical rule (desktop only) -->
  <div aria-hidden="true" class="absolute left-6 top-0 bottom-0 z-[2] hidden lg:flex flex-col items-center py-16 gap-0">
    <div class="w-px flex-1 bg-gradient-to-b from-transparent via-white/25 to-white/15"></div>
    <span class="text-[9px] font-medium tracking-[0.45em] uppercase text-white/35 [writing-mode:vertical-rl] py-5 select-none">Раковски</span>
    <div class="w-px flex-1 bg-gradient-to-b from-white/15 via-white/25 to-transparent"></div>
  </div>

  <!-- Right vertical rule (desktop only) -->
  <div aria-hidden="true" class="absolute right-6 top-0 bottom-0 z-[2] hidden lg:flex flex-col items-center py-16 gap-0">
    <div class="w-px flex-1 bg-gradient-to-b from-transparent via-white/25 to-white/15"></div>
    <span class="text-[9px] font-medium tracking-[0.45em] uppercase text-white/35 [writing-mode:vertical-rl] py-5 select-none">2026</span>
    <div class="w-px flex-1 bg-gradient-to-b from-white/15 via-white/25 to-transparent"></div>
  </div>

  <!-- Mobile bottom horizontal 2026 rule -->
  <div aria-hidden="true" class="absolute bottom-5 inset-x-6 z-[2] flex items-center justify-center gap-4 lg:hidden">
    <span class="h-px flex-1 bg-gradient-to-r from-transparent to-white/25"></span>
    <span class="text-[10px] font-medium tracking-[0.42em] uppercase text-white/50">2026</span>
    <span class="h-px flex-1 bg-gradient-to-l from-transparent to-white/25"></span>
  </div>

  <!-- Main content -->
  <div class="absolute inset-0 z-10 px-6 sm:px-12 lg:px-24">
    <div class="flex h-full items-center justify-center">
      <div class="max-w-2xl text-center">

      <!-- Eyebrow -->
      <div class="flex items-center justify-center gap-4 mb-0">
        <span class="block h-px w-10 bg-white/80 shrink-0"></span>
        <span class="text-xl sm:text-2xl lg:text-3xl font-semibold tracking-[0.12em] uppercase text-white/80 [text-shadow:0_2px_10px_rgba(0,0,0,0.45)]">Ритеил парк</span>
        <span class="block h-px w-10 bg-white/80 shrink-0"></span>
      </div>

      <!-- H1 -->
      <h1 class="text-white tracking-tight leading-none [text-shadow:0_4px_18px_rgba(0,0,0,0.55)]">
        <span class="block text-6xl sm:text-8xl lg:text-[6.5rem] font-extrabold -mt-3 sm:-mt-4 lg:-mt-5">Раковски</span>
      </h1>


      <!-- Help text -->
      <p class="mt-3 sm:mt-4 text-white/70 text-base sm:text-lg leading-relaxed max-w-md mx-auto [text-shadow:0_2px_10px_rgba(0,0,0,0.45)]">
        Всичко от което се нуждате е вече на едно място. Спестяваш време
      </p>
      </div>
    </div>

    <!-- CTA -->
    <div class="absolute left-1/2 -translate-x-1/2 bottom-20 sm:bottom-24 lg:bottom-32">
      <a
        href="{{ '/obekti/' | url }}"
        class="inline-flex items-center gap-3 rounded-full bg-brand-teal px-7 py-3.5 min-w-[15rem] justify-center whitespace-nowrap text-white font-semibold shadow-lg shadow-black/25 hover:brightness-110 transition text-sm sm:text-base"
      >
        Разгледай обектите
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
      </a>
    </div>
  </div>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: За нас  (editorial, dark, split-screen with stat ribbon)
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-stretch">
      {# ── IMAGE CARD (floating) ── #}
      <div class="relative order-last lg:order-last lg:col-span-5 rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden ring-1 ring-white/40 shadow-2xl shadow-slate-900/15 min-h-[320px] sm:min-h-[420px] lg:min-h-[520px]">
        <img
          src="{{ home.about.image.src }}"
          alt="{{ home.about.image.alt }}"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-950/60 via-slate-950/25 to-brand-teal/20 mix-blend-multiply" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/10 to-transparent" aria-hidden="true"></div>

        <div class="absolute left-6 top-6 sm:left-8 sm:top-8 flex items-center gap-3">
          <span class="h-px w-8 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-white/85">{{ home.about.floatingBadge.eyebrow }}</span>
        </div>

        <div class="absolute left-6 bottom-6 sm:left-10 sm:bottom-10 max-w-[85%]">
          <div class="text-[10px] sm:text-xs font-medium tracking-[0.3em] uppercase text-white/70">{{ home.about.floatingBadge.line1 }}</div>
          <div class="mt-1 text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[0.95] uppercase">
            {{ home.about.floatingBadge.line2 }}
          </div>
        </div>
      </div>

      {# ── TEXT CARD (floating) ── #}
      <div class="relative order-first lg:order-first lg:col-span-7 rounded-[2rem] sm:rounded-[2.5rem] bg-white/92 backdrop-blur-sm flex flex-col lg:justify-center">
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">{{ home.about.badge }}</span>
        </div>

        <h2 class="mt-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
          {{ home.about.titlePrefix }}
          <span class="block italic font-light text-slate-900">
            <span class="underline decoration-brand-yellow decoration-[3px] underline-offset-[10px]">{{ home.about.titleHighlight }}</span>.
          </span>
        </h2>

        <div class="mt-8 space-y-4 text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl">
          {% for paragraph in home.about.paragraphs %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-5">
          {% for button in home.about.buttons %}
            {% if button.style == 'primary' %}
              <a
                href="{{ button.url | url }}"
                class="inline-flex items-center gap-2 rounded-full bg-brand-teal px-6 py-3 text-sm font-semibold tracking-wide text-white shadow-lg shadow-black/20 transition hover:brightness-110"
              >
                {{ button.label }}
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
              </a>
            {% else %}
              <a
                href="{{ button.url | url }}"
                class="group inline-flex items-center gap-2 text-sm font-semibold tracking-wide text-slate-700 hover:text-slate-900"
              >
                {{ button.label }}
                <span class="h-px w-6 bg-slate-400 transition-all group-hover:w-10 group-hover:bg-brand-yellow"></span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {# ── SEPARATE COUNTER STRIP (floating) ── #}
    <div class="mt-8 sm:mt-10 rounded-[1.75rem] sm:rounded-[2.25rem] overflow-hidden bg-white shadow-xl shadow-slate-900/10">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-slate-200/80">
        {% for counter in home.about.counters %}
          {% set suffixIsUnit = counter.suffix and counter.suffix != '+' %}
          <div class="relative px-5 py-7 sm:px-7 sm:py-9 group">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 tabular-nums js-counter" data-counter-target="{{ counter.value }}">0</span>
              {% if counter.suffix == '+' %}
                <span class="text-2xl sm:text-3xl font-extrabold text-brand-yellow leading-none">+</span>
              {% elif suffixIsUnit %}
                <span class="text-base sm:text-lg font-medium text-slate-500 leading-none">{{ counter.suffix }}</span>
              {% endif %}
            </div>
            <div class="mt-3 text-[10px] sm:text-xs uppercase tracking-[0.25em] font-semibold text-slate-500">{{ counter.label }}</div>
            <span class="absolute left-5 sm:left-7 bottom-3 h-px w-0 bg-brand-yellow/80 transition-all duration-500 group-hover:w-12"></span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <script src="{{ '/assets/js/counters.js' | url }}" defer></script>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: Обекти  (editorial, floating cards — no wrapper container)
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative bg-white/80 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">

    {# ── EDITORIAL HEADER ── #}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-8">
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">Обекти</span>
        </div>

        <h2 class="mt-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
          Търговски обекти
          <span class="block italic font-light text-slate-900">
            <span class="underline decoration-brand-yellow decoration-[3px] underline-offset-[10px]">и партньори</span>.
          </span>
        </h2>

        <p class="mt-8 text-base sm:text-lg text-slate-600 leading-relaxed max-w-4xl">
          Всичко от което се нуждаете на едно място — пазар, мода, услуги и хранене. Подбрани марки и удобства, събрани под един покрив.
        </p>
      </div>
    </div>

  </div>

  {# ── MOVING / DRAGGABLE PARTNER STRIP (full viewport width) ── #}
  <div class="partners-strip-wrapper mt-10 sm:mt-14 pb-4">
    <div class="pt-4 partners-strip" aria-label="Партньори">
      <div class="partners-strip-set pb-4">
        {% for shop in shops.items %}
          <article
            class=" group relative w-[250px] sm:w-[300px] flex-shrink-0 rounded-3xl bg-white p-7 sm:p-8 shadow-lg shadow-black/10 ring-1 ring-slate-200/60 hover:shadow-xl hover:shadow-black/15 hover:-translate-y-1 transition-all duration-300"
          >
            <span
              class="absolute left-8 top-0 h-px w-10 -translate-y-px bg-brand-yellow transition-all duration-300 group-hover:w-24"
              aria-hidden="true"
            ></span>

            <div
              class="flex items-center justify-center {% if shop.logo %}w-full min-h-[5rem] sm:min-h-[5.5rem]{% else %}h-20 w-20 sm:h-24 sm:w-24 rounded-full overflow-hidden text-white font-bold text-2xl sm:text-3xl{% endif %}"
              {% if not shop.logo %}style="background-color: {{ shop.color | default('#006484') }}"{% endif %}
            >
              {% if shop.logo %}
                <img
                  src="{{ shop.logo | url }}"
                  alt=""
                  class="h-16 w-auto max-w-full sm:h-20 select-none object-contain object-center [-webkit-user-drag:none]"
                  width="200"
                  height="100"
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                />
              {% else %}
                {{ shop.title | truncate(1, true, '') }}
              {% endif %}
            </div>

            <h3 class="mt-7 text-xl sm:text-2xl font-bold text-slate-900 leading-tight">{{ shop.title }}</h3>
            <p class="mt-2 text-[11px] sm:text-xs uppercase tracking-[0.2em] font-semibold text-slate-500">{{ shop.category }}</p>

            <a
              href="{{ shop.url | default('#') }}"
              class="absolute right-7 bottom-7 inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-400 transition hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900"
              aria-label="Виж повече за {{ shop.title }}"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            </a>
          </article>
        {% endfor %}
      </div>
      <div class="partners-strip-set" aria-hidden="true">
        {% for shop in shops.items %}
          <article
            class="group relative w-[250px] sm:w-[300px] flex-shrink-0 rounded-3xl bg-white p-7 sm:p-8 shadow-lg shadow-black/10 ring-1 ring-slate-200/60 hover:shadow-xl hover:shadow-black/15 hover:-translate-y-1 transition-all duration-300"
          >
            <span
              class="absolute left-8 top-0 h-px w-10 -translate-y-px bg-brand-yellow transition-all duration-300 group-hover:w-24"
              aria-hidden="true"
            ></span>

            <div
              class="flex items-center justify-center {% if shop.logo %}w-full min-h-[5rem] sm:min-h-[5.5rem]{% else %}h-20 w-20 sm:h-24 sm:w-24 rounded-full overflow-hidden text-white font-bold text-2xl sm:text-3xl{% endif %}"
              {% if not shop.logo %}style="background-color: {{ shop.color | default('#006484') }}"{% endif %}
            >
              {% if shop.logo %}
                <img
                  src="{{ shop.logo | url }}"
                  alt=""
                  class="h-16 w-auto max-w-full sm:h-20 select-none object-contain object-center [-webkit-user-drag:none]"
                  width="200"
                  height="100"
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                />
              {% else %}
                {{ shop.title | truncate(1, true, '') }}
              {% endif %}
            </div>

            <h3 class="mt-7 text-xl sm:text-2xl font-bold text-slate-900 leading-tight">{{ shop.title }}</h3>
            <p class="mt-2 text-[11px] sm:text-xs uppercase tracking-[0.2em] font-semibold text-slate-500">{{ shop.category }}</p>

            <a
              href="{{ shop.url | default('#') }}"
              class="absolute right-7 bottom-7 inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-400 transition hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900"
              aria-label="Виж повече за {{ shop.title }}"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            </a>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
  <script src="{{ '/assets/js/partners-strip.js' | url }}" defer></script>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: Последни новини  (editorial header + карти; mobile horizontal scroll)
   ───────────────────────────────────────────────────────────────────────── #}
<section id="novini" class="relative scroll-mt-28 bg-white/80 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">

    {# ── EDITORIAL HEADER (Обекти / За нас pattern) ── #}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end mb-10 sm:mb-14">
      <div class="lg:col-span-8">
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">Новини</span>
        </div>
        <h2 class="mt-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
          Последни новини
          <span class="block italic font-light text-slate-900">
            <span class="underline decoration-brand-yellow decoration-[3px] underline-offset-[10px]">и събития</span>.
          </span>
        </h2>
        <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl">
          Актуално от парка — откривания, нови партньори, промени в работно време и полезни съобщения за посетители.
        </p>
      </div>
      <div class="lg:col-span-4 flex lg:justify-end">
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full bg-brand-teal px-6 py-3 text-sm font-semibold tracking-wide text-white shadow-lg shadow-black/20 transition hover:brightness-110"
        >
          Всички новини
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
        </a>
      </div>
    </div>

    {# Mobile: full-viewport-wide row (first card aligns w/ headings; scrolled cards reach screen edge · no snap) #}
    <div
      class="relative left-1/2 w-screen max-w-[100vw] -translate-x-1/2 md:contents md:left-auto md:w-auto md:max-w-none md:translate-x-0"
    >
      <div
        class="news-cards-scroller flex gap-5 overflow-x-auto overscroll-x-contain pb-14 pt-5 md:mx-0 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:pb-0 md:pt-0"
        aria-label="Списък новини"
      >
      {% for post in news.items %}
        <article class="news-card relative w-[280px] min-w-[280px] shrink-0 overflow-hidden rounded-3xl bg-white shadow-lg shadow-black/10 ring-1 ring-slate-200/60 max-md:first:ml-4 max-md:last:mr-4 sm:max-md:first:ml-6 sm:max-md:last:mr-6 md:min-w-0 md:w-auto md:shrink">
          <div class="news-card__media relative aspect-[16/10] overflow-hidden">
            <img
              src="{{ post.image | url }}"
              alt="{{ post.title }}"
              class="news-card__img absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/55 via-transparent to-transparent opacity-70" aria-hidden="true"></div>
            <div class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-white/95 px-3 py-1.5 text-[11px] font-semibold tracking-wide text-slate-900 shadow-sm backdrop-blur-sm">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-yellow"></span>
              {{ post.date }}
            </div>
          </div>
          <div class="relative px-6 pb-7 pt-2 sm:p-7">
            <span
              class="news-card__accent absolute left-6 top-0 h-px w-10 -translate-y-px bg-brand-yellow sm:left-7"
              aria-hidden="true"
            ></span>
            <h3 class="news-card__title mt-5 text-lg sm:text-xl font-bold leading-snug tracking-tight text-slate-900">
              {{ post.title }}
            </h3>
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-600">
              {{ post.excerpt }}
            </p>
            <a
              href="{{ post.url | default('#') }}"
              class="news-card__link mt-6 inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-800"
            >
              Прочети повече
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            </a>
          </div>
        </article>
      {% endfor %}
      </div>
    </div>
  </div>
</section>

