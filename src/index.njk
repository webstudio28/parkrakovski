---
layout: base.njk
title: Home
description: Welcome to the base Eleventy website.
---

<section
  id="hero-section"
  class="relative -mt-20 min-h-[100svh] w-full overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-[var(--color-brand-teal)] pt-20 sm:-mt-24 sm:pt-24"
>
  <video
    id="hero-video"
    class="absolute inset-0 z-0 min-h-[100%] min-w-full object-cover"
    src="{{ '/assets/videos/hero-video.mp4' | url }}"
    muted
    autoplay
    loop
    playsinline
    preload="auto"
    webkit-playsinline=""
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <script>
    (function () {
      var v = document.getElementById("hero-video");
      if (!v) return;

      function prepare() {
        v.muted = true;
        v.defaultMuted = true;
        v.setAttribute("muted", "");
        try {
          v.playsInline = true;
        } catch (_) {}
        v.setAttribute("playsinline", "");
        v.setAttribute("webkit-playsinline", "");
      }

      function tryPlay() {
        prepare();
        var p = v.play();
        if (p && typeof p.catch === "function") {
          p.catch(function () {});
        }
      }

      function onError() {
        try {
          v.removeAttribute("src");
        } catch (_) {}
        v.classList.add("hidden");
      }

      v.addEventListener("error", onError);

      function init() {
        prepare();
        tryPlay();
        v.addEventListener("loadedmetadata", tryPlay);
        v.addEventListener("canplay", tryPlay);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }

      document.addEventListener(
        "pointerdown",
        function () {
          tryPlay();
        },
        true,
      );

      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) tryPlay();
      });
    })();
  </script>

  <!-- Dark overlay -->
  <div class="absolute inset-0 z-[1] bg-black/75"></div>

  <div class="relative z-10 flex min-h-[100svh] items-center justify-center px-4">
    <div class="text-center max-w-3xl">
      <h1 class="text-white tracking-tight">
        <span class="block text-3xl sm:text-5xl font-light">Ритеил парк</span>
        <span class="block text-4xl sm:text-6xl font-extrabold mt-2">Раковски</span>
      </h1>

      <p class="mt-6 text-white/90 text-base sm:text-lg leading-relaxed">
        Всичко от което се нуждате е вече на едно място. Спестяваш време
      </p>

      <div class="mt-8 flex items-center justify-center">
        <a
          href="{{ '/services/' | url }}"
          class="inline-flex items-center justify-center rounded-2xl bg-brand-yellow px-7 py-3 text-white font-semibold shadow-lg shadow-black/20 hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-black/30"
        >
          Разгледай обектите
        </a>
      </div>
    </div>
  </div>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: За нас
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative overflow-hidden py-20 sm:py-28 bg-[var(--color-bg)]">
  <div class="pointer-events-none absolute -top-40 -left-32 h-[420px] w-[420px] rounded-full bg-brand-teal/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 -right-24 h-[340px] w-[340px] rounded-full bg-brand-yellow/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      {# Image column #}
      <div class="relative order-last lg:order-first">
        <div class="relative aspect-[4/5] sm:aspect-[5/6] lg:aspect-[4/5] max-w-md mx-auto lg:mx-0">
          <div class="pointer-events-none absolute -top-6 -left-6 h-32 w-32 rounded-full bg-brand-yellow/30 blur-2xl" aria-hidden="true"></div>
          <div class="pointer-events-none absolute -bottom-8 -right-8 h-40 w-40 rounded-full bg-brand-teal/30 blur-2xl" aria-hidden="true"></div>

          <div class="relative h-full w-full rounded-[2.5rem] overflow-hidden ring-1 ring-slate-200 shadow-2xl shadow-slate-900/15">
            <img
              src="{{ home.about.image.src }}"
              alt="{{ home.about.image.alt }}"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-tr from-slate-900/40 via-slate-900/10 to-transparent"></div>
          </div>

          {# Floating "since" badge #}
          <div class="absolute -bottom-6 -left-6 sm:-bottom-8 sm:-left-8 rounded-3xl bg-white shadow-xl shadow-slate-900/15 ring-1 ring-slate-200 px-5 py-4 flex items-center gap-3">
            <div class="h-12 w-12 rounded-full bg-brand-yellow/15 ring-1 ring-brand-yellow/30 flex items-center justify-center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-brand-yellow" aria-hidden="true">
                <path d="M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4Z"/>
              </svg>
            </div>
            <div>
              <div class="text-[10px] sm:text-xs font-semibold tracking-[0.2em] text-slate-500 uppercase">{{ home.about.floatingBadge.eyebrow }}</div>
              <div class="text-base sm:text-lg font-bold text-slate-900 leading-tight">{{ home.about.floatingBadge.line1 }}<br/>{{ home.about.floatingBadge.line2 }}</div>
            </div>
          </div>
        </div>
      </div>

      {# Text column #}
      <div>
        <span class="inline-flex items-center gap-2.5 rounded-full bg-brand-yellow/15 px-4 py-1.5 ring-1 ring-brand-yellow/30">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
          <span class="text-[11px] sm:text-xs font-semibold tracking-[0.25em] text-brand-yellow uppercase">{{ home.about.badge }}</span>
        </span>
        <h2 class="mt-5 text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
          {{ home.about.titlePrefix }} <span class="text-brand-teal">{{ home.about.titleHighlight }}</span>
        </h2>
        <div class="mt-5 flex items-center gap-2">
          <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
          <span class="h-1 w-12 rounded-full bg-brand-yellow"></span>
          <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
        </div>

        <div class="mt-6 space-y-4 text-slate-600 text-base sm:text-lg leading-relaxed">
          {% for paragraph in home.about.paragraphs %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          {% for button in home.about.buttons %}
            <a
              href="{{ button.url | url }}"
              class="{% if button.style == 'primary' %}inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-slate-900/20 transition hover:bg-brand-teal{% else %}inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 ring-1 ring-slate-200 transition hover:ring-brand-yellow hover:text-brand-teal{% endif %}"
            >
              {{ button.label }}
              {% if button.style == 'primary' %}
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
              {% endif %}
            </a>
          {% endfor %}
        </div>
      </div>
    </div>

    {# Counters #}
    <div class="mt-16 sm:mt-24 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for counter in home.about.counters %}
        {% set accent = counter.accent or 'yellow' %}
        {% set iconWrapClass = 'bg-brand-yellow/15 ring-brand-yellow/30' if accent == 'yellow' else 'bg-brand-teal/15 ring-brand-teal/30' %}
        {% set iconClass = 'text-brand-yellow' if accent == 'yellow' else 'text-brand-teal' %}
        {% set dotClass = 'bg-brand-yellow' if accent == 'yellow' else 'bg-brand-teal' %}
        {% set suffixClass = 'text-brand-yellow' if accent == 'yellow' and counter.suffix == '+' else ('text-brand-teal' if counter.suffix == '+' else 'text-slate-500') %}
        <div class="group relative rounded-3xl bg-white p-6 sm:p-7 ring-1 ring-slate-200/70 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-start justify-between">
            <div class="h-12 w-12 sm:h-14 sm:w-14 rounded-2xl ring-1 flex items-center justify-center {{ iconWrapClass }}">
              {% if counter.icon == 'shops' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7 {{ iconClass }}" aria-hidden="true">
                  <path d="M3 7h18l-1.6 11.2a2 2 0 0 1-2 1.8H6.6a2 2 0 0 1-2-1.8L3 7Z"/>
                  <path d="M8 7V5a4 4 0 0 1 8 0v2"/>
                </svg>
              {% elif counter.icon == 'parking' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7 {{ iconClass }}" aria-hidden="true">
                  <path d="M5 17v-6a4 4 0 0 1 4-4h6l4 4v6"/>
                  <circle cx="7.5" cy="17.5" r="1.5"/>
                  <circle cx="16.5" cy="17.5" r="1.5"/>
                  <path d="M5 13h14"/>
                </svg>
              {% elif counter.icon == 'area' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7 {{ iconClass }}" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="3"/>
                  <path d="M3 9h18M9 3v18"/>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7 {{ iconClass }}" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 7v5l3 2"/>
                </svg>
              {% endif %}
            </div>
            <span class="h-2 w-2 rounded-full group-hover:scale-150 transition-transform {{ dotClass }}"></span>
          </div>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 tabular-nums js-counter" data-counter-target="{{ counter.value }}">0</span>
            {% if counter.suffix %}
              <span class="text-xl sm:text-2xl font-bold ml-2 {{ suffixClass }}">{{ counter.suffix }}</span>
            {% endif %}
          </div>
          <div class="mt-2 text-sm sm:text-base font-medium text-slate-600">{{ counter.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  <script>
    (function () {
      var counters = document.querySelectorAll(".js-counter");
      if (!counters.length) return;

      function format(n) {
        return Math.round(n).toLocaleString("bg-BG");
      }

      function animate(el) {
        var target = parseInt(el.getAttribute("data-counter-target"), 10) || 0;
        var duration = 1400;
        var start = performance.now();
        function step(now) {
          var t = Math.min(1, (now - start) / duration);
          var eased = 1 - Math.pow(1 - t, 3);
          el.textContent = format(target * eased);
          if (t < 1) requestAnimationFrame(step);
          else el.textContent = format(target);
        }
        requestAnimationFrame(step);
      }

      if (!("IntersectionObserver" in window)) {
        counters.forEach(animate);
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animate(entry.target);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.4 });

      counters.forEach(function (c) { io.observe(c); });
    })();
  </script>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: Обекти (Shops & services)
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative overflow-hidden py-20 sm:py-28 bg-[var(--color-bg)]">
  <div class="pointer-events-none absolute -top-40 -right-32 h-[420px] w-[420px] rounded-full bg-brand-yellow/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-32 h-[360px] w-[360px] rounded-full bg-brand-teal/5 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-flex items-center gap-2.5 rounded-full bg-brand-yellow/15 px-4 py-1.5 ring-1 ring-brand-yellow/30">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
        <span class="text-[11px] sm:text-xs font-semibold tracking-[0.25em] text-brand-yellow uppercase">Обекти</span>
      </span>
      <h2 class="mt-5 text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
        Магазини и услуги
      </h2>
      <div class="mx-auto mt-5 flex items-center justify-center gap-2">
        <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
        <span class="h-1 w-12 rounded-full bg-brand-yellow"></span>
        <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
      </div>
      <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed">
        Всичко от което се нуждаете на едно място — пазар, мода, услуги и хранене.
      </p>
    </div>

    <div class="mt-12 sm:mt-16 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for shop in shops.items %}
        <a
          href="{{ shop.url | default('#') }}"
          class="group relative rounded-3xl bg-white p-5 sm:p-6 ring-1 ring-slate-200/70 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:ring-brand-yellow transition-all duration-300"
        >
          <div
            class="h-14 w-14 sm:h-16 sm:w-16 rounded-full flex items-center justify-center text-white font-bold text-xl sm:text-2xl shadow-lg ring-4 ring-white"
            style="background-color: {{ shop.color | default('#006484') }}"
          >
            {{ shop.title | truncate(1, true, '') }}
          </div>
          <h3 class="mt-4 sm:mt-5 text-base sm:text-lg font-bold text-slate-900">{{ shop.title }}</h3>
          <p class="mt-1 text-xs sm:text-sm text-slate-500">{{ shop.category }}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-brand-teal opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0 transition-all">
            Виж повече
            <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{# ─────────────────────────────────────────────────────────────────────────
   SECTION: Последни новини
   ───────────────────────────────────────────────────────────────────────── #}
<section class="relative overflow-hidden py-20 sm:py-28 bg-slate-50">
  <div class="pointer-events-none absolute top-1/2 -left-40 h-[420px] w-[420px] -translate-y-1/2 rounded-full bg-brand-teal/5 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-32 right-1/3 h-72 w-72 rounded-full bg-brand-yellow/5 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-12 sm:mb-14">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2.5 rounded-full bg-brand-yellow/15 px-4 py-1.5 ring-1 ring-brand-yellow/30">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
          <span class="text-[11px] sm:text-xs font-semibold tracking-[0.25em] text-brand-yellow uppercase">Новини</span>
        </span>
        <h2 class="mt-5 text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
          Последни новини
        </h2>
        <div class="mt-5 flex items-center gap-2">
          <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
          <span class="h-1 w-12 rounded-full bg-brand-yellow"></span>
          <span class="h-1 w-2 rounded-full bg-brand-yellow"></span>
        </div>
      </div>
      <a
        href="#"
        class="self-start sm:self-auto inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 ring-1 ring-slate-200 hover:ring-brand-yellow hover:text-brand-teal transition"
      >
        Всички новини
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {% for post in news.items %}
        <article class="group rounded-3xl bg-white overflow-hidden ring-1 ring-slate-200/70 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src="{{ post.image }}"
              alt="{{ post.title }}"
              class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-white/95 backdrop-blur px-3 py-1 text-xs font-semibold text-slate-900 shadow">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
              {{ post.date }}
            </div>
          </div>
          <div class="p-6 sm:p-7">
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-brand-teal transition-colors">
              {{ post.title }}
            </h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed line-clamp-3">
              {{ post.excerpt }}
            </p>
            <a
              href="{{ post.url | default('#') }}"
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-teal"
            >
              Прочети повече
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

