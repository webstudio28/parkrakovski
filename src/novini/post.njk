---
pagination:
  data: news.items
  size: 1
  alias: post
permalink: "/novini/{{ post.slug }}/"
layout: inner.njk
eleventyComputed:
  title: "{{ post.title }} — Ритейл парк Раковски"
  description: "{{ post.excerpt | stripHtml | truncateChars(160) }}"
---

<section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">

    {# ── Breadcrumb ── #}
    <nav class="mb-10 flex items-center gap-2 text-sm text-slate-500" aria-label="Навигация">
      <a href="{{ '/' | url }}" class="transition hover:text-slate-900">Начало</a>
      <span aria-hidden="true" class="text-slate-300">/</span>
      <a href="{{ '/novini/' | url }}" class="transition hover:text-slate-900">Новини</a>
      <span aria-hidden="true" class="text-slate-300">/</span>
      <span class="font-medium text-slate-900 truncate max-w-[200px] sm:max-w-xs">{{ post.title }}</span>
    </nav>

    {# ── Article layout ── #}
    <div class="relative grid grid-cols-1 gap-6 sm:gap-8 lg:gap-10 items-start">

      {# Main content card #}
      <div>

        {# Title + date — above hero image #}
        <header class="mb-5 sm:mb-6">
          <div class="flex items-center gap-3 mb-3 sm:mb-4">
            <span class="h-px w-8 bg-brand-yellow"></span>
            <time class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow" datetime="{{ post.date }}">{{ post.date }}</time>
          </div>
          <h1 class="text-2xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight text-slate-900 leading-tight">{{ post.title }}</h1>
        </header>

        {# Hero image #}
        <div class="relative overflow-hidden rounded-[2rem] sm:rounded-[2.5rem] shadow-2xl shadow-slate-900/15 ring-1 ring-white/40 aspect-[16/9] w-full lg:w-[70%]">
          <img
            src="{{ post.image | url }}"
            alt="{{ post.title }}"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
          />
        </div>

        {# Excerpt / lead ── #}
        <div class="mt-6 sm:mt-8 flex items-start gap-4 rounded-[1.5rem] bg-white/92 backdrop-blur-sm p-6 sm:p-8 shadow-lg shadow-slate-900/10 ring-1 ring-slate-200/60">
          <span class="mt-1 shrink-0 block h-px w-10 bg-brand-yellow"></span>
          <p class="rich-content text-base sm:text-lg text-slate-700 leading-relaxed italic">{{ post.excerpt | safe }}</p>
        </div>

        {# Body text card #}
        <div class="mt-5 rounded-[1.75rem] sm:rounded-[2rem] bg-white shadow-xl shadow-slate-900/10 p-7 sm:p-10">
          <div class="rich-content prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-slate-700 prose-headings:font-extrabold prose-a:text-brand-teal prose-a:no-underline hover:prose-a:underline prose-blockquote:border-brand-yellow prose-blockquote:text-slate-500 prose-strong:text-slate-900" data-rich-body>
            {{ post.body | safe }}
          </div>

          <script>
          (function () {
            function classify(img) {
              function apply() {
                if (img.naturalWidth > 0 && img.naturalHeight > 0) {
                  img.dataset.orientation = img.naturalHeight > img.naturalWidth ? "portrait" : "landscape";
                }
              }
              if (img.complete && img.naturalWidth > 0) { apply(); }
              else { img.addEventListener("load", apply, { once: true }); }
            }
            function run() {
              document.querySelectorAll("[data-rich-body] img").forEach(classify);
            }
            if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", run); }
            else { run(); }
          })();
          </script>
        </div>

        {# Back link #}
        <div class="mt-8">
          <a
            href="{{ '/novini/' | url }}"
            class="group inline-flex items-center gap-2 text-sm font-semibold tracking-wide text-slate-700 hover:text-slate-900"
          >
            <svg class="h-4 w-4 rotate-180 transition-transform group-hover:-translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/></svg>
            Към всички новини
            <span class="h-px w-6 bg-slate-400 transition-all group-hover:w-10 group-hover:bg-brand-yellow"></span>
          </a>
        </div>
      </div>

      {# Other news — full width below article ── #}
      <aside class="mt-4">
        <div class="flex items-center gap-3 mb-6">
          <span class="h-px w-10 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">Още новини</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for other in news.items %}
          {% if other.slug != post.slug %}
          <a
            href="{{ ('/novini/' ~ other.slug ~ '/') | url }}"
            class="group relative flex gap-4 rounded-2xl bg-white p-4 shadow-md shadow-black/[0.07] ring-1 ring-slate-200/60 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
          >
            <span class="absolute left-4 top-0 h-px w-6 -translate-y-px bg-brand-yellow transition-all duration-300 group-hover:w-14" aria-hidden="true"></span>
            <img
              src="{{ other.image | url }}"
              alt=""
              class="h-16 w-16 shrink-0 rounded-xl object-cover"
              loading="lazy"
              aria-hidden="true"
            />
            <div class="min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-widest text-brand-yellow mb-1">{{ other.date }}</p>
              <p class="text-sm font-bold leading-snug text-slate-900 group-hover:text-brand-teal transition-colors line-clamp-2">{{ other.title }}</p>
            </div>
          </a>
          {% endif %}
        {% endfor %}
        </div>
      </aside>

    </div>
  </div>
</section>
