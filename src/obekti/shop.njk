---
pagination:
  data: shops.items
  size: 1
  alias: shop
permalink: "/obekti/{{ shop.slug }}/"
layout: inner.njk
eleventyComputed:
  title: "{{ shop.title }} — Ритеил парк Раковски"
  description: "{{ shop.description }}"
---

{# ── Breadcrumb ──────────────────────────────────────────────────────────── #}
<nav class="mx-auto max-w-7xl px-4 sm:px-6 mb-8" aria-label="Навигация">
  <ol class="flex items-center gap-2 text-sm text-slate-500">
    <li><a href="{{ '/' | url }}" class="transition hover:text-slate-900">Начало</a></li>
    <li aria-hidden="true"><span class="text-slate-300">/</span></li>
    <li><a href="{{ '/obekti/' | url }}" class="transition hover:text-slate-900">Обекти</a></li>
    <li aria-hidden="true"><span class="text-slate-300">/</span></li>
    <li class="font-medium text-slate-900">{{ shop.title }}</li>
  </ol>
</nav>

{# ── Hero card ───────────────────────────────────────────────────────────── #}
<section class="mx-auto max-w-7xl px-4 sm:px-6">
  <div class="overflow-hidden rounded-3xl bg-white shadow-xl shadow-black/[0.08] ring-1 ring-slate-200/60">
    {# Top accent #}
    <div class="h-2 w-full" style="background-color: {{ shop.color }};"></div>

    <div class="flex flex-col gap-8 p-8 sm:p-12 md:flex-row md:items-center md:gap-12">
      {# Logo block #}
      <div class="flex shrink-0 items-center justify-center rounded-2xl bg-slate-50 p-8 md:h-44 md:w-44">
        <img
          src="{{ shop.logo | url }}"
          alt="{{ shop.title }}"
          class="max-h-24 max-w-[160px] object-contain"
          loading="eager"
          decoding="async"
        />
      </div>

      {# Details #}
      <div class="flex-1 space-y-4">
        <div>
          <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white" style="background-color: {{ shop.color }};">
            {{ shop.category }}
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{{ shop.title }}</h1>
        <p class="text-base leading-relaxed text-slate-600">{{ shop.description }}</p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          {% if shop.hours %}
          <div class="flex items-center gap-2 text-sm text-slate-500">
            <svg class="h-4 w-4 shrink-0 text-[var(--color-brand-teal)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
            {{ shop.hours }}
          </div>
          {% endif %}
          {% if shop.url %}
          <a
            href="{{ shop.url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--color-brand-teal)] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
          >
            Официален сайт
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
              <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
            </svg>
          </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Info section ───────────────────────────────────────────────────────── #}
<section class="py-14 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">

      {# About the shop #}
      <div class="rounded-3xl bg-white/80 p-8 shadow-md shadow-black/[0.06] ring-1 ring-slate-200/50">
        <div class="flex items-center gap-2 mb-5">
          <span class="block h-3 w-3 rounded-full bg-[var(--color-brand-yellow)]"></span>
          <h2 class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--color-brand-yellow)]">За обекта</h2>
        </div>
        <p class="text-slate-700 leading-relaxed">
          Добре дошли в <strong>{{ shop.title }}</strong> — {{ shop.category | lower }} в Ритеил парк Раковски. Тук ще намерите богат асортимент от продукти и услуги, съчетани с приятна атмосфера и квалифицирано обслужване. Посетете ни и убедете се лично!
        </p>
        <p class="mt-4 text-slate-700 leading-relaxed">
          Комплексът разполага с удобен паркинг за над 120 автомобила и лесен достъп от главните пътища. Очакваме ви всеки ден с усмивка!
        </p>
      </div>

      {# Location & Info #}
      <div class="rounded-3xl bg-white/80 p-8 shadow-md shadow-black/[0.06] ring-1 ring-slate-200/50">
        <div class="flex items-center gap-2 mb-5">
          <span class="block h-3 w-3 rounded-full bg-[var(--color-brand-teal)]"></span>
          <h2 class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--color-brand-teal)]">Местоположение</h2>
        </div>
        <div class="space-y-3 text-sm text-slate-700">
          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>
            </svg>
            <span>Ритеил парк Раковски, ул. Примерна 1, Раковски, обл. Пловдив</span>
          </div>
          {% if shop.hours %}
          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
            <span>{{ shop.hours }}</span>
          </div>
          {% endif %}
        </div>
      </div>

    </div>

    {# Back link #}
    <div class="mt-12 text-center">
      <a
        href="{{ '/obekti/' | url }}"
        class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-[var(--color-brand-teal)] hover:text-[var(--color-brand-teal)]"
      >
        <svg class="h-4 w-4 rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z"/>
        </svg>
        Към всички обекти
      </a>
    </div>
  </div>
</section>
