---
pagination:
  data: shops.items
  size: 1
  alias: shop
permalink: "/obekti/{{ shop.slug }}/"
layout: inner.njk
eleventyComputed:
  title: "{{ shop.title }} в Ритеил парк Раковски"
  description: "{{ shop.description | stripHtml }}"
---

<section class="relative bg-white/80 pt-28 sm:pt-32 pb-20 sm:pb-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">

    {# ── Breadcrumb ── #}
    <nav class="mb-10 flex items-center gap-2 text-sm text-slate-500" aria-label="Навигация">
      <a href="{{ '/' | url }}" class="transition hover:text-slate-900">Начало</a>
      <span aria-hidden="true" class="text-slate-300">/</span>
      <a href="{{ '/obekti/' | url }}" class="transition hover:text-slate-900">Обекти</a>
      <span aria-hidden="true" class="text-slate-300">/</span>
      <span class="font-medium text-slate-900">{{ shop.title }}</span>
    </nav>

    {# ── Hero: left-aligned copy + photo ── #}
    <div class="relative grid grid-cols-1 items-stretch gap-8 sm:gap-10 lg:grid-cols-12 lg:gap-10">

      {# Text block — no card container #}
      <div class="relative order-first flex flex-col text-left lg:col-span-7 lg:justify-center lg:pr-4">
        <div class="flex items-center justify-start gap-3">
          <span class="h-px w-10 shrink-0 bg-brand-yellow"></span>
          <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">{{ shop.category }}</span>
        </div>

        {% if shop.logo %}
        <div class="mt-5 flex justify-start">
          <img
            src="{{ shop.logo | url }}"
            alt=""
            class="max-h-12 max-w-[200px] w-auto object-contain object-left sm:max-h-14"
            loading="eager"
            decoding="async"
            aria-hidden="true"
          />
        </div>
        {% endif %}

        <h1 class="mt-5 max-w-3xl text-lg font-medium leading-relaxed text-slate-800 sm:text-xl">
          {{ shop.title }} в Ритеил парк Раковски
        </h1>

        <div class="rich-content mt-6 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          {{ shop.description | safe }}
        </div>

        {% if shop.url %}
        <div class="mt-10 flex flex-wrap items-center justify-start gap-5">
          <a
            href="{{ shop.url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-brand-teal px-6 py-3 text-sm font-semibold tracking-wide text-white shadow-lg shadow-black/20 transition hover:brightness-110"
          >
            Официален сайт
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/></svg>
          </a>
        </div>
        {% endif %}
      </div>

      {# Photo card #}
      {% set shopImage = shop.image | default('/assets/images/news/news3.webp') %}
      <div class="relative order-last lg:col-span-5 min-h-[260px] sm:min-h-[360px] lg:min-h-[520px] overflow-hidden rounded-[2rem] sm:rounded-[2.5rem] ring-1 ring-white/40 shadow-2xl shadow-slate-900/15">
        <img
          src="{{ shopImage | url }}"
          alt="{{ shop.title }}"
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
        <div class="shop-hero__scrim" aria-hidden="true"></div>

        <div class="shop-hero__caption">
          <div class="flex items-center gap-3">
            <span class="h-px w-10 shrink-0 bg-brand-yellow" aria-hidden="true"></span>
            <span class="text-xs font-medium leading-snug text-white sm:text-sm">{{ site.brand.name | default('Ритеил парк Раковски') }}</span>
          </div>
        </div>
      </div>

    </div>

    {# ── Info strip — only blocks with data ── #}
    {% set hourLines = shop.hours | formatShopHours %}
    {% set hasPhone = shop.phone and (shop.phone | replace(' ', '') | replace('-', '') | length) > 0 %}
  <div class="mt-8 sm:mt-10 rounded-[1.75rem] sm:rounded-[2.25rem] overflow-hidden bg-white shadow-xl shadow-slate-900/10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(min(100%,12rem),1fr))] divide-y sm:divide-y-0 sm:divide-x divide-slate-200/80">
        <div class="relative px-7 py-8 sm:py-9 group">
          <div class="flex items-center gap-3 mb-3">
            <svg class="h-5 w-5 text-brand-teal shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
            <span class="text-[10px] uppercase tracking-[0.25em] font-semibold text-slate-500">Местоположение</span>
          </div>
          <p class="text-sm text-slate-700 leading-relaxed">Ритеил парк Раковски<br/>ул. Примерна 1, Раковски</p>
          <span class="absolute left-7 bottom-3 h-px w-0 bg-brand-yellow/80 transition-all duration-500 group-hover:w-12"></span>
        </div>
        {% if hourLines.length %}
        <div class="relative px-7 py-8 sm:py-9 group">
          <div class="flex items-center gap-3 mb-3">
            <svg class="h-5 w-5 text-brand-yellow shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="text-[10px] uppercase tracking-[0.25em] font-semibold text-slate-500">Работно време</span>
          </div>
          <div class="text-sm text-slate-700 leading-relaxed space-y-1">
            {% for line in hourLines %}
              <p>{{ line }}</p>
            {% endfor %}
          </div>
          <span class="absolute left-7 bottom-3 h-px w-0 bg-brand-yellow/80 transition-all duration-500 group-hover:w-12"></span>
        </div>
        {% endif %}
        {% if hasPhone %}
        <div class="relative px-7 py-8 sm:py-9 group">
          <div class="flex items-center gap-3 mb-3">
            <svg class="h-5 w-5 text-brand-teal shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <span class="text-[10px] uppercase tracking-[0.25em] font-semibold text-slate-500">Телефон</span>
          </div>
          <a href="tel:{{ shop.phone | replace(' ', '') | replace('-', '') }}" class="text-sm font-semibold text-brand-teal hover:underline">{{ shop.phone }}</a>
          <span class="absolute left-7 bottom-3 h-px w-0 bg-brand-yellow/80 transition-all duration-500 group-hover:w-12"></span>
        </div>
        {% endif %}
        {% if shop.category %}
        <div class="relative px-7 py-8 sm:py-9 group">
          <div class="flex items-center gap-3 mb-3">
            <svg class="h-5 w-5 text-brand-teal shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
            <span class="text-[10px] uppercase tracking-[0.25em] font-semibold text-slate-500">Категория</span>
          </div>
          <p class="text-sm font-semibold text-slate-900">{{ shop.category }}</p>
          <span class="absolute left-7 bottom-3 h-px w-0 bg-brand-yellow/80 transition-all duration-500 group-hover:w-12"></span>
        </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% if shop.promotions and shop.promotions | length %}
{% from "macros/promotion-card.njk" import promotionCard %}
<section class="relative border-t border-slate-200/80 bg-white/80 py-16 sm:py-24" aria-labelledby="shop-promotions-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex items-center gap-3">
      <span class="h-px w-10 bg-brand-yellow"></span>
      <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">Промоции</span>
    </div>
    <h2 id="shop-promotions-heading" class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
      Актуални оферти
      <span class="block italic font-light text-slate-900">
        <span class="underline decoration-brand-yellow decoration-[3px] underline-offset-[10px]">в {{ shop.title }}</span>
      </span>
    </h2>
  </div>

  <div data-promotions-wrap>
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="promotions-carousel__head mt-8 sm:mt-10">
        <p class="promotions-carousel__label" id="shop-promotions-carousel-label">
          Промоции
        </p>
        <div class="promotions-carousel__nav">
          <button
            type="button"
            class="promotions-carousel__arrow promotions-carousel__arrow--prev"
            data-promotions-prev
            aria-label="Предишна промоция"
          >
            <svg class="promotions-carousel__chevron" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="21 8 12 16 21 24" vector-effect="non-scaling-stroke"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="promotions-carousel__arrow promotions-carousel__arrow--next"
            data-promotions-next
            aria-label="Следваща промоция"
          >
            <svg class="promotions-carousel__chevron" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="11 8 20 16 11 24" vector-effect="non-scaling-stroke"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="promotions-carousel__viewport">
      <div
        class="promotions-carousel__track"
        data-promotions-scroller
        aria-labelledby="shop-promotions-carousel-label"
        role="list"
      >
        {% for promo in shop.promotions %}
          {{ promotionCard(shop, promo, false) }}
        {% endfor %}
      </div>
    </div>
  </div>
  <script src="{{ '/assets/js/promotions-carousel.js' | url }}" defer></script>
</section>
{% endif %}

{% if (shop.images and shop.images.length) or (shop.promotions and shop.promotions.length) %}
<section class="relative border-t border-slate-200/80 bg-white py-16 sm:py-24" aria-labelledby="shop-gallery-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex items-center gap-3">
      <span class="h-px w-10 bg-brand-yellow"></span>
      <span class="text-[10px] sm:text-xs font-semibold tracking-[0.32em] uppercase text-brand-yellow">Галерия</span>
    </div>
    <h2 id="shop-gallery-heading" class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
      Снимки
      <span class="italic font-light text-slate-900">
        <span class="underline decoration-brand-yellow decoration-[3px] underline-offset-[10px]">от {{ shop.title }}</span>
      </span>
    </h2>
  </div>

  <div data-gallery-wrap>
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="gallery-carousel__head mt-8 sm:mt-10">
        <p class="gallery-carousel__label" id="shop-gallery-carousel-label">
          Галерия
        </p>
        <div class="gallery-carousel__nav">
          <button
            type="button"
            class="gallery-carousel__arrow gallery-carousel__arrow--prev"
            data-gallery-prev
            aria-label="Предишна снимка"
          >
            <svg class="gallery-carousel__chevron" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="21 8 12 16 21 24" vector-effect="non-scaling-stroke"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="gallery-carousel__arrow gallery-carousel__arrow--next"
            data-gallery-next
            aria-label="Следваща снимка"
          >
            <svg class="gallery-carousel__chevron" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="11 8 20 16 11 24" vector-effect="non-scaling-stroke"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="gallery-carousel__viewport">
      <div
        class="gallery-carousel__track"
        data-gallery-scroller
        aria-labelledby="shop-gallery-carousel-label"
        role="list"
      >
        {% if shop.images and shop.images.length %}
          {% for image in shop.images %}
          <article
            class="gallery-card gallery-card--interactive"
            role="listitem"
            data-gallery-lightbox-trigger
            data-gallery-lightbox-index="{{ loop.index0 }}"
          >
            <img
              src="{{ image.src | default(image) | url }}"
              alt="{{ image.alt | default(shop.title) }}"
              class="gallery-card__image"
              data-gallery-lightbox-item
              data-gallery-lightbox-index="{{ loop.index0 }}"
              loading="lazy"
              decoding="async"
            />
          </article>
          {% endfor %}
        {% else %}
          {% for promo in shop.promotions %}
          <article
            class="gallery-card gallery-card--interactive"
            role="listitem"
            data-gallery-lightbox-trigger
            data-gallery-lightbox-index="{{ loop.index0 }}"
          >
            <img
              src="{{ promo.image | url }}"
              alt="{{ promo.alt | default(shop.title) }}"
              class="gallery-card__image"
              data-gallery-lightbox-item
              data-gallery-lightbox-index="{{ loop.index0 }}"
              loading="lazy"
              decoding="async"
            />
          </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
  <script src="{{ '/assets/js/gallery-carousel.js' | url }}" defer></script>
</section>
{% endif %}
