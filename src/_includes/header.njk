<header class="fixed top-3 left-0 right-0 z-50 px-4 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <div class="pk-header-surface js-header-surface">
      <a href="{{ '/' | url }}" class="shrink-0 inline-flex items-center" aria-label="{{ site.brand.name }}">
        <img
          src="{{ '/assets/images/logo.png' | url }}"
          alt="{{ site.brand.name }}"
          class="h-8 sm:h-10 w-auto"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center justify-center" aria-label="Main">
        <ul class="flex items-center gap-1 text-sm">
          {% for item in site.nav.header %}
            <li class="relative group">
              <a
                href="{{ item.url | url }}"
                class="pk-desktop-link inline-flex items-center rounded-full px-3 py-2 font-medium transition"
              >
                {{ item.label }}
              </a>

              {% if item.children and item.children.length %}
                <ul class="pointer-events-none absolute left-1/2 top-full z-20 mt-2 min-w-52 -translate-x-1/2 rounded-2xl border border-slate-200 bg-white/95 p-1.5 opacity-0 shadow-xl shadow-slate-900/10 backdrop-blur transition group-hover:pointer-events-auto group-hover:opacity-100">
                  {% for child in item.children %}
                    <li>
                      <a
                        href="{{ child.url | url }}"
                        class="block rounded-xl px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-slate-900"
                      >
                        {{ child.label }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

      <button
        type="button"
        class="pk-mobile-toggle md:hidden ml-auto"
        id="mobile-menu-toggle"
        aria-label="Отвори меню"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
      >
        <span class="pk-mobile-toggle__line"></span>
        <span class="pk-mobile-toggle__line"></span>
        <span class="pk-mobile-toggle__line"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu-backdrop" class="pk-mobile-backdrop" aria-hidden="true" hidden></div>

<aside id="mobile-menu-panel" class="pk-mobile-panel" aria-hidden="true" hidden>
  <div class="pk-mobile-panel__inner">
    <button
      type="button"
      class="pk-mobile-close"
      id="mobile-menu-close"
      aria-label="Затвори меню"
    >
      &times;
    </button>

    <nav class="pk-mobile-nav" aria-label="Mobile">
      {% for item in site.nav.header %}
        <a href="{{ item.url | url }}" class="pk-mobile-link">{{ item.label }}</a>
        {% if item.children and item.children.length %}
          {% for child in item.children %}
            <a href="{{ child.url | url }}" class="pk-mobile-sublink">{{ child.label }}</a>
          {% endfor %}
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</aside>

