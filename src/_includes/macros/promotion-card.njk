{% macro promotionCard(shop, promo, showShopTitle) %}
  <article class="promotion-card group" role="listitem">
    <div class="promotion-card__inner">
      <div class="promotion-card__media relative aspect-[3/4] overflow-hidden rounded-3xl shadow-lg shadow-black/12 ring-1 ring-slate-200/60 transition duration-300 group-hover:-translate-y-1 group-hover:shadow-xl group-hover:ring-slate-300/70">
        <span
          class="absolute left-4 top-4 z-[1] h-px w-10 bg-brand-yellow transition-all duration-300 group-hover:w-14 sm:left-5 sm:top-5"
          aria-hidden="true"
        ></span>
        <img
          src="{{ promo.image | url }}"
          alt="{{ promo.alt | default(shop.title + ' — промоция') }}"
          class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.03] select-none"
          width="600"
          height="800"
          draggable="false"
          loading="lazy"
          decoding="async"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent opacity-90" aria-hidden="true"></div>
      </div>
      <div class="mt-4 sm:mt-5">
        {% if showShopTitle %}
          <p class="text-lg sm:text-xl font-bold leading-tight tracking-tight text-slate-900">
            {{ shop.title }}
          </p>
        {% endif %}
        <p class="{% if showShopTitle %}mt-2 sm:mt-2.5 {% endif %}text-sm sm:text-base leading-relaxed text-slate-600">
          {{ promo.description }}
        </p>
      </div>
    </div>
  </article>
{% endmacro %}
