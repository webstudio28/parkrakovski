<!doctype html>
<html lang="{{ site.brand.language | default('en') }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {% set pageTitle = title or site.seo.defaultTitle %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ description or site.seo.defaultDescription }}" />
    <link rel="canonical" href="{{ site.seo.siteUrl }}{{ page.url | url }}" />

    <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml" />
    <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}" />

    <style>
      :root {
        --color-bg: {{ site.colors.background | default('#FFFFFF') }};
        --color-brand-blue: {{ site.colors.blue | default('#003E8D') }};
        --color-brand-teal: {{ site.colors.teal | default('#006484') }};
        --color-brand-yellow: {{ site.colors.yellow | default('#B5961D') }};
      }
    </style>
  </head>

  <body class="min-h-dvh flex flex-col bg-[var(--color-bg)] text-slate-900">
    {% include "header.njk" %}

    <main class="flex-1">
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}
  </body>
</html>

